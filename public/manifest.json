{
  "manifest_version": 3,
  "name": "Klarsicht – Accessibility Checker",
  "short_name": "Klarsicht",
  "version": "0.1.3",
  "description": "Scan any page against WCAG 2.2, see issues highlighted in place and get concrete code fixes. Ready for BFSG / EN 301 549.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Klarsicht: open the accessibility panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
